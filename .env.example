BOT_TOKEN=put-your-token-here

# Relative paths are resolved from the project directory.
DB_PATH=./data/bot.sqlite3
DOWNLOAD_BASE=./downloads

# Optional exact default target for /descargar, /sincronizar, and schedules
# when no group-specific /carpeta is set.
DEFAULT_DOWNLOAD_DIR=

# Optional comma-separated allowlists. Leave empty while setting up.
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=

# By default, /descargar only accepts folders inside DOWNLOAD_BASE.
# Set true only if you want commands to write to absolute server paths.
ALLOW_ABSOLUTE_DOWNLOAD_PATHS=false

# Public Bot API getFile limit. Files above this are listed as skipped by size.
MAX_DOWNLOAD_BYTES=20971520

# Public Bot API defaults. To support files >20MB, run a local Bot API server
# and point these at it, e.g. http://127.0.0.1:8081/bot and http://127.0.0.1:8081/file/bot
BOT_API_BASE_URL=https://api.telegram.org/bot
BOT_API_FILE_BASE_URL=https://api.telegram.org/file/bot

APP_TIMEZONE=America/Mexico_City
PROGRESS_EDIT_SECONDS=2.5
SCHEDULER_POLL_SECONDS=30
