BOT_TOKEN=replace-with-your-bot-token

# All relative paths are resolved from the working directory.
DB_PATH=./data/bot.sqlite3
DOWNLOAD_BASE=./downloads/music/Telegram
DEFAULT_DOWNLOAD_DIR=
ALLOWED_USER_IDS=
ALLOWED_CHAT_IDS=
ALLOW_ABSOLUTE_DOWNLOAD_PATHS=false
MAX_DOWNLOAD_BYTES=20971520
BOT_API_BASE_URL=https://api.telegram.org/bot
BOT_API_FILE_BASE_URL=https://api.telegram.org/file/bot
APP_TIMEZONE=UTC
PROGRESS_EDIT_SECONDS=2.5
SCHEDULER_POLL_SECONDS=30

# Optional Mornye bridge. Keep disabled until docs/mornye.md is complete.
MORNYE_ENABLED=false
# Comma-separated music owners; falls back to ALLOWED_USER_IDS when unset.
# An empty allowlist never enables music downloads for everyone.
MUSIC_ALLOWED_USER_IDS=
MUSIC_ROOT=./downloads/music
# Use absolute paths if changing these defaults.
MORNYE_HOME=./runtime/mornye
MORNYE_PYTHON=./runtime/mornye/.venv/bin/python
CHROME_PATH=/usr/bin/google-chrome

# Dedicated signed-in Spotify browser; used only to find the current daylist URL.
MORNYE_SPOTIFY_BROWSER_URL=http://127.0.0.1:9223
